# Non-secret deploy config shared by every workflow. Each job loads it into
# $GITHUB_ENV first ("Load deploy config"). The GitHub secrets are only a few
# API tokens, the CI Tokens; SECRETS.md lists them.
#
# Values are grouped into modules ("# @module <name> required|optional").
# Deploys run once every required module is filled in, so the empty template,
# or a new app mid-setup, skips them. An optional module is on when all of
# its values are filled in and off otherwise; part-filled counts as off,
# with a warning. .github/scripts/deploy-config.sh reads this file.
#
# Empty in the Able template: PLAYBOOK.md fills the values in while setting
# up a new app.

# @module app required
# The App Handle: names the app's telemetry services (<APP_HANDLE>-backend,
# <APP_HANDLE>-frontend).
APP_HANDLE=myapp

# @module neon required
# The app's project (in a Realtime region). Production reads/writes the
# default branch; each PR gets preview/pr-<n> branched from it.
NEON_PROJECT_ID=
NEON_PROD_BRANCH=
NEON_DB_NAME=
NEON_DB_ROLE=
# Pinned: Realtime is in beta and its CLI surface is still moving.
NEON_CLI=neon@9.1.0

# @module fly required
# Production app; Previews are <app>-pr-<n>. App names are global on Fly.
FLY_ORG=
FLY_BACKEND_APP=

# @module cloudflare required
# Cloudflare Pages
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=
PROD_FRONTEND_ORIGIN=

# @module workos required
# WorkOS Production environment Client ID, shared by Production and every
# Preview (one user pool). The backend's JWKS URL is derived from it.
WORKOS_CLIENT_ID=

# @module grafana optional
# Observability: Grafana Cloud. The backend sends traces, metrics and logs to
# the Grafana Stack's OTLP gateway (with the GRAFANA_OTLP_TOKEN secret); the
# frontend reports to its Frontend Observability (Faro) app. None of these
# is a secret: the Faro collector URL ships in the frontend bundle.
GRAFANA_STACK_URL=
GRAFANA_OTLP_ENDPOINT=
GRAFANA_OTLP_INSTANCE_ID=
GRAFANA_FARO_URL=
