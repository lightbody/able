# Non-secret deploy config shared by every workflow. Each job loads it into
# $GITHUB_ENV first ("Load deploy config"). The GitHub secrets are only a few
# API tokens, the CI Tokens; SECRETS.md lists them.
#
# Empty in the Able template: PLAYBOOK.md fills every value in while setting
# up a new app. Deploy jobs skip themselves (with a notice) while any value
# is empty -- see .github/workflows/deploy-config.yml.

# The App Handle: the app's technical name, e.g. in its telemetry service
# names (<APP_HANDLE>-backend, <APP_HANDLE>-frontend).
APP_HANDLE=myapp

# Cloudflare Pages
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=
PROD_FRONTEND_ORIGIN=

# able:begin postgres
# Neon -- the app's project (in a Realtime region). Prod reads/writes the
# default branch; each PR gets preview/pr-<n> branched from it.
NEON_PROJECT_ID=
NEON_PROD_BRANCH=
NEON_DB_NAME=
NEON_DB_ROLE=
# Pinned: Realtime is in beta and its CLI surface is still moving.
NEON_CLI=neon@9.1.0
# able:end

# able:begin backend
# Fly -- prod app; previews are <app>-pr-<n>. App names are global on Fly.
FLY_ORG=
FLY_BACKEND_APP=
# able:end

# able:begin auth
# WorkOS -- Production environment Client ID, shared by prod and every PR
# preview (one user pool). The backend's JWKS URL is derived from it.
WORKOS_CLIENT_ID=
# able:end

# able:begin observability
# Grafana Cloud -- observability. The backend sends traces, metrics and logs
# to the Grafana Stack's OTLP gateway (with the GRAFANA_OTLP_TOKEN secret);
# the frontend reports to its Frontend Observability (Faro) app. None of
# these is a secret: the Faro collector URL ships in the frontend bundle.
GRAFANA_STACK_URL=
GRAFANA_OTLP_ENDPOINT=
GRAFANA_OTLP_INSTANCE_ID=
GRAFANA_FARO_URL=
# able:end
