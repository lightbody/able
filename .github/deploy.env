# Non-secret deploy config shared by every workflow. Each job loads it into
# $GITHUB_ENV first ("Load deploy config"). The only GitHub secrets are the
# three API tokens: NEON_API_KEY, FLY_API_TOKEN, CLOUDFLARE_API_TOKEN.
#
# Empty in the Able template: PLAYBOOK.md fills every value in while setting
# up a new app. Deploy jobs skip themselves (with a notice) while any value
# is empty -- see .github/workflows/deploy-config.yml.

# Neon -- the app's project (in a Realtime region). Prod reads/writes the
# default branch; each PR gets preview/pr-<n> branched from it.
NEON_PROJECT_ID=
NEON_PROD_BRANCH=
NEON_DB_NAME=
NEON_DB_ROLE=
# Pinned: Realtime is in beta and its CLI surface is still moving.
NEON_CLI=neon@8.23.3

# Fly -- prod app; previews are <app>-pr-<n>. App names are global on Fly.
FLY_ORG=
FLY_BACKEND_APP=

# Cloudflare Pages
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=
PROD_FRONTEND_ORIGIN=

# WorkOS -- Production environment Client ID, shared by prod and every PR
# preview (one user pool). The backend's JWKS URL is derived from it.
WORKOS_CLIENT_ID=
