# --- Local dev ---
# DATABASE_URL, NEON_REALTIME_URL and NEON_REALTIME_SECRET come from your
# personal Neon branch and live in .env.local -- see .env.local.example.
PORT=8080
ALLOWED_ORIGIN=http://localhost:5173
# Postgres database the live queries run against -- must match
# NEON_DB_NAME in .github/deploy.env (Neon's default is "neondb").
NEON_DB_NAME=neondb

# --- Production: set by .github/actions/deploy-backend on every deploy ---
# DATABASE_URL, NEON_REALTIME_URL, NEON_REALTIME_SECRET (pulled from Neon),
# NEON_DB_NAME, WORKOS_JWKS_URL, ALLOWED_ORIGIN (from .github/deploy.env).
# OTEL_EXPORTER_OTLP_ENDPOINT, OTEL_SERVICE_NAME, OTEL_RESOURCE_ATTRIBUTES and
# the Fly secret OTEL_EXPORTER_OTLP_HEADERS, from deploy.env's Grafana values
# and the GRAFANA_OTLP_TOKEN secret (see README "Observability").

# --- Telemetry (optional; off when OTEL_EXPORTER_OTLP_ENDPOINT is unset) ---
# Set these to send local traces/metrics/logs somewhere, e.g. a local
# collector or the app's Grafana Stack.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-us-east-0.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64 of instanceId:token>
# OTEL_SERVICE_NAME=myapp-backend
# OTEL_RESOURCE_ATTRIBUTES=service.namespace=myapp,deployment.environment.name=myapp-dev-<you>
# LOG_LEVEL=info
