# Copy this to .env.local: it holds the values that differ per developer,
# and is never committed.

# able:begin postgres
# Add your Neon branch's credentials with (from backend/):
#
#   neon env pull --branch dev/<you> --service postgres --service realtime --file .env.local
#
# which writes DATABASE_URL, NEON_REALTIME_URL and NEON_REALTIME_SECRET here
# and leaves the other lines alone.
# able:end

# able:begin auth
# WorkOS -- Development environment Client ID, for local dev only
WORKOS_JWKS_URL=https://api.workos.com/sso/jwks/client_YOUR_DEVELOPMENT_CLIENT_ID
# able:end
