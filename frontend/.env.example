# --- Local dev ---
# Leave VITE_API_URL unset -- Vite proxy handles /api -> localhost:8080

# --- Production: frontend.yml sets VITE_API_URL and VITE_WORKOS_CLIENT_ID
# from .github/deploy.env at build time, plus the telemetry values below.

# --- Telemetry (optional; Grafana Faro is off when unset) ---
# VITE_GRAFANA_FARO_URL=https://faro-collector-prod-<region>.grafana.net/collect/<app key>
# VITE_DEPLOY_ENVIRONMENT=myapp-dev-<you>
